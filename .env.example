# QuantAgent Environment Configuration
# Copy this to .env and fill in your values

# === General ===
APP_NAME=QuantAgent
APP_ENV=development  # development | production
LOG_LEVEL=INFO

# === Trading Mode ===
TRADING_MODE=paper  # paper | live

# === Solana ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY_ENCRYPTED=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# === BSC ===
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_WSS_URL=wss://bsc-ws-node.nariox.org
BSC_PRIVATE_KEY_ENCRYPTED=
PANCAKESWAP_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256924E

# === AI / LLM ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o  # gpt-4o | claude-3-5-sonnet

# === Data Providers ===
BIRDEYE_API_KEY=  # Solana OHLCV + on-chain data (free: 100 req/day)
LLM_MAX_TOKENS=2000

# === Database ===
# Leave empty for SQLite (auto-created). For production:
# DATABASE_URL=postgresql+asyncpg://quantagent:quantagent@localhost:5432/quantagent
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# === Security ===
ENCRYPTION_KEY=  # AES-256 key for private key encryption

# === Risk Management ===
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_LOSS_USD=500
MAX_SLIPPAGE_BPS=100  # 1%
